{
  "name": "tick-talk",
  "private": true,
  "version": "1.0.0",
  "description": "Tick Talk: explica cinco palavras antes que o tempo acabe.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json && vite build",
    "play": "npm run build && vite preview --host --port 5174 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "cards": "node scripts/generate-cards.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
