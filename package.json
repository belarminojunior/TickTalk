{
  "name": "tick-talk",
  "private": true,
  "version": "1.0.0",
  "description": "Tick Talk: explica cinco palavras antes que o tempo acabe.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c yellow,cyan \"tsx watch server/index.ts --dev\" \"vite\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "play": "npm run build && tsx server/index.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cards": "node scripts/generate-cards.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.17.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
